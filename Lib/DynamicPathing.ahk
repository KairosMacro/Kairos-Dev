Connections := Map()

Link(node1, node2, time, bidirectional := true) {
    if !Locations.Has(node1) || !Locations.Has(node2)
        return
    if !Connections.Has(node1)
        Connections[node1] := []
    Connections[node1].Push({to: node2, time: time})
    if (bidirectional) {
        if !Connections.Has(node2)
            Connections[node2] := []
        Connections[node2].Push({to: node1, time: time})
    }
}

