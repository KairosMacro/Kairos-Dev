Connections := Map()

Link(node1, node2, time := -1, dist := -1, bidirectional := true) {
    if !Locations.Has(node1) || !Locations.Has(node2)
        return
    if (dist == -1) {
        l1 := Locations[node1], l2 := Locations[node2]
        dist := Sqrt((l2.x - l1.x)**2 + (l2.y - l1.y)**2 + (l2.z - l1.z)**2)
    }
    if (time = -1) {
        time := dist / 36.68
    }
    AddEntry(from, to, d, t) {
        if !Connections.Has(from)
            Connections[from] := []
        Connections[from].Push({to: to, time: t})
    }
    AddEntry(node1, node2, dist, time)
    if (bidirectional)
        AddEntry(node2, node1, dist, time)
}

