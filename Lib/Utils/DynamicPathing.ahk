try {
    start := "Spawn"
    goal := "Black Bear"
    result := FindPath(start, goal)
    MsgBox("Path from " start " to " goal ":`n" result)
} catch {
    msgbox "uh oh, something went wrong"
}

FindPath(startNode, endNode) {
    openSet := Map()
    openSet[startNode] := true

    cameFrom := Map()

    gScore := Map()
    gScore.Default := 999999999
    gScore[startNode] := 0

    fScore := Map()
    fScore.Default := 999999999
    fScore[startNode] := GetHeuristic(startNode, endNode)

    while (openSet.Count > 0) {
        current := GetBestNode(openSet, fScore)

        if (current = endNode)
            return constructPath(cameFrom, current, gScore)

        openSet.Delete(current)

        if (Connections.Has(current)) {
            for neighborObj in Connections[current] {
                neighbor := neighborObj.to
                weight := neighborObj.time

                tentative_gScore := gScore[current] + weight

                if (tentative_gScore < gScore[neighbor]) {
                    cameFrom[neighbor] := current
                    gScore[neighbor] := tentative_gScore
                    fScore[neighbor] := tentative_gScore + GetHeuristic(neighbor, endNode)

                    if !openSet.Has(neighbor)
                        openSet[neighbor] := true
                }
            }
        }
    }
    return "no path found"
}

GetHeuristic(current, goal) {
    if !Locations.Has(current) || !Locations.Has(goal)
        return 999999999
    curr := Locations[current]
    dest := Locations[goal]
    return Sqrt((dest.x - curr.x)**2 + (dest.y - curr.y)**2 + (dest.z - curr.z)**2)
}

GetBestNode(openSet, fScore) {
    lowestScore := 999999999
    bestNode := ""
    for node, _ in openSet {
        if (fScore[node] < lowestScore) {
            lowestScore := fScore[node]
            bestNode := node
        }
    }
    return bestNode
}

constructPath(cameFrom, current, gScore) {
    totalTime := gScore[current]
    path := []
    path.Push(current)

    while (cameFrom.has(current)) {
        current := cameFrom[current]
        path.InsertAt(1, current)
    }

    readablePath := ""
    for index, nodeName in path {
        readablePath .= (index = 1 ? "" : " -> ") nodeName
    }
    return readablePath . "`nTotal Time: " totalTime
}
